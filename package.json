{
  "name": "adhan-desk",
  "productName": "Adhan Desk",
  "version": "0.1.0",
  "description": "Your mosque's prayer times and full adhan on your desktop.",
  "author": "Adhan Desk contributors",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/kamran-jabbar/adhan-desk.git"},
  "homepage": "https://github.com/kamran-jabbar/adhan-desk#readme",
  "bugs": {"url": "https://github.com/kamran-jabbar/adhan-desk/issues"},
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "electron-builder --win --x64 --dir",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.adhdesk.desktop",
    "productName": "Adhan Desk",
    "directories": {"output": "dist"},
    "files": ["src/**/*", "assets/**/*", "package.json", "LICENSE", "docs/AUDIO-LICENSE.md"],
    "win": {"target": "nsis", "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true},
    "mac": {"target": "dmg", "category": "public.app-category.lifestyle"},
    "linux": {"target": "AppImage", "category": "Utility", "desktop": {"entry": {"StartupWMClass": "adhan-desk"}}}
  }
}
